---
type Props = astroHTML.JSX.AnchorHTMLAttributes;
const { props } = Astro;
---

<a
  class={`flex-1 border-b-2 border-transparent py-2 transition-colors duration-100 sm:flex-none sm:rounded-xl sm:border-0 sm:px-4 sm:py-3 ${
    Astro.url.pathname.startsWith(props.href as string)
      ? "border-b-current sm:bg-gray-300 sm:dark:bg-gray-600"
      : "hover:bg-gray-200 dark:hover:bg-gray-700"
  }`}
  {...props}
>
  <slot />
</a>
