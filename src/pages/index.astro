---
import { Icon } from "astro-icon/components";

import BaseLayout from "@/layouts/BaseLayout.astro";
import links from "@/navigation.json";

const contact = [
  {
    url: "https://github.com/wxh06",
    title: "GitHub @wxh06",
    icon: "simple-icons:github",
  },
  {
    url: "https://t.me/wangxinhe",
    title: "Telegram @wangxinhe",
    icon: "simple-icons:telegram",
  },
  {
    url: "mailto:wangxinhe06@gmail.com",
    title: "Email: wangxinhe06@gmail.com",
    icon: "simple-icons:gmail",
  },
  {
    url: "https://blog.wxh.im/",
    title: "Blog",
    icon: "fa6-solid:blog",
  },
];
---

<BaseLayout title="汪心禾">
  <div class="flex h-screen flex-col justify-center">
    <main class="text-center">
      <h1 class="text-4xl">汪心禾</h1>
      <p class="text-3xl">Wang, Xinhe</p>
      <div class="mt-4 flex justify-center divide-x divide-dashed divide-gray-300 text-3xl dark:divide-gray-600">
        {contact.map(({ url, title, icon }) => (
          <div class="px-3">
            <a
              class="flex py-1 transition-[scale] duration-100 hover:scale-110"
              title={title}
              href={url}
              target="_blank"
              rel="noreferrer me"
            >
              <Icon name={icon} title={title} />
            </a>
          </div>
        ))}
      </div>
    </main>

    <nav class="mt-6 grid justify-center gap-2 text-lg sm:flex sm:gap-4">
      {links.map(({ href, text }) => (
        <a
          class="flex items-center justify-between gap-4 py-1 transition-colors duration-100 sm:rounded-full sm:bg-gray-200 sm:px-4 sm:hover:bg-gray-300 sm:dark:bg-gray-700 sm:dark:hover:bg-gray-600"
          href={href}
        >
          {text}
          <Icon
            name="fa6-solid:arrow-right"
            class="size-4 sm:hidden"
            aria-hidden="true"
          />
        </a>
      ))}
    </nav>
  </div>
</BaseLayout>
