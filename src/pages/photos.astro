---
// The map's stylesheet belongs to the page, not to the script that draws
// the map: styles a script imports are injected when it first runs, and a
// client-side navigation back to this page swaps them out without running
// the script again, leaving the map to lay out unstyled.
import "maplibre-gl/dist/maplibre-gl.css";

import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";

import BaseLayout from "@/layouts/BaseLayout.astro";
import Layout from "@/layouts/Layout.astro";
import { stayGeometries } from "@/photos/geo";
import { groupTimeline } from "@/photos/timeline";

const entries = groupTimeline(
  (await getCollection("photos")).map(({ id, data }) => ({ id, ...data })),
);
const geometries = stayGeometries(entries);

const regionNames = new Intl.DisplayNames(["en"], { type: "region" });
// Entry days are date-only strings, which parse as UTC midnight; formatting
// in UTC keeps them on the same calendar day.
const days = new Intl.DateTimeFormat("en", {
  dateStyle: "long",
  timeZone: "UTC",
});
const formatDays = (start: string, end: string) =>
  days.formatRange(new Date(start), new Date(end));

const join = (parts: (string | undefined)[], separator: string) =>
  parts.filter(Boolean).join(separator);

// The sublocation is left out when the heading already names it, and the
// file name only stands in when nothing else identifies the photo.
const caption = (
  entry: { location?: string | undefined },
  photo: {
    id: string;
    title?: string | undefined;
    location?: string | undefined;
  },
) => photo.title ?? (entry.location ? undefined : (photo.location ?? photo.id));
---

<BaseLayout title="Photography">
  <Layout>
    {/* Whether focal lengths read as 35 mm equivalents: one choice for the
    page, kept by this box, which every focal length is a label for. Shown
    only while focused from the keyboard, so that the tab stop is not an
    invisible one, and fixed even while hidden, where sr-only would put it at
    the top of the page, so that taking focus from a label does not scroll
    the page to it. */}
    <label class="fixed bottom-4 left-4 z-10 flex items-center gap-2 rounded-full bg-white px-3 py-1.5 text-sm shadow-lg ring-1 ring-gray-200 not-has-focus-visible:sr-only not-has-focus-visible:fixed dark:bg-zinc-900 dark:ring-gray-700">
      <input id="focal-equivalent" type="checkbox" />
      Show 35 mm equivalent focal lengths
    </label>
    <div class="sm:short:flex sm:short:gap-4">
      <ol class="py-4 sm:short:min-w-0 sm:short:flex-1">
        {entries.map((entry, index) => (
          <li
            class="mb-8"
            data-stay
            data-geometry={JSON.stringify(geometries[index])}
          >
            <h2 class="mb-2 text-xl">
              <span data-stay-date>{formatDays(entry.start, entry.end)}</span> ·{" "}
              <span data-stay-place>
                {join(
                  [
                    entry.location,
                    entry.city,
                    regionNames.of(entry.countryCode),
                  ],
                  ", ",
                )}
              </span>
            </h2>
            <ul class="flex flex-col items-center gap-2 sm:flex-row sm:flex-wrap sm:items-stretch">
              {entry.photos.map(({ id, image, title, ...data }) => (
                <li data-photo={id} data-place={data.location}>
                  <div class="relative">
                    <Image src={image} height={240} alt={title ?? id} />
                    {/* The box overhangs a portrait to the left, which in the
                    first column is off the page on a viewport no wider than
                    the container. */}
                    <div class="group absolute right-0.5 bottom-0.5 rounded-xl text-xs text-white backdrop-blur-sm hover:bg-black/60 focus-within:bg-black/60">
                      <div class="hidden p-2 whitespace-nowrap group-hover:block group-focus-within:block">
                        <ul>
                          <li class="flex items-center gap-1">
                            <Icon
                              name="lucide:camera"
                              class="size-3 shrink-0"
                              role="img"
                              title="Camera"
                            />
                            {join([data.camera.make, data.camera.model], " ")}
                          </li>
                          {/* Takes no width of its own, so that the lens name
                          is cut to the other lines instead of widening the box. */}
                          {data.lens && (
                            <li class="flex w-0 min-w-full items-center gap-1">
                              <Icon
                                name="lucide:aperture"
                                class="size-3 shrink-0"
                                role="img"
                                title="Lens"
                              />
                              <span class="truncate" title={data.lens}>
                                {data.lens}
                              </span>
                            </li>
                          )}
                        </ul>
                        <hr class="-mx-2 my-1 border-white/15" />
                        {/* The label is focusable so that pressing it keeps
                        focus inside the box: pressing a non-focusable one blurs
                        the button, which closes the box before the click lands. */}
                        <p class="pr-5">
                          ISO {data.exposure.iso} ·{" "}
                          <label
                            class="cursor-pointer underline decoration-dotted underline-offset-2"
                            for="focal-equivalent"
                            tabindex="-1"
                          >
                            <span class="[:root:has(#focal-equivalent:checked)_&]:hidden">
                              {data.exposure.focalLength} mm
                            </span>
                            <span class="hidden [:root:has(#focal-equivalent:checked)_&]:inline">
                              {data.exposure.focalLength35mm} mm equiv.
                            </span>
                          </label>{" "}
                          · <i>f</i>/{data.exposure.fNumber} ·{" "}
                          {data.exposure.exposureTime}
                        </p>
                      </div>
                      <button
                        class="absolute right-1 bottom-1 flex size-6 items-center justify-center"
                        type="button"
                        aria-label="Details"
                      >
                        <Icon name="fa6-solid:circle-info" class="size-4" />
                      </button>
                    </div>
                  </div>
                  <p class="text-sm text-gray-500">
                    {caption(entry, { id, title, location: data.location })}
                  </p>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ol>
      {/* As a picture in picture the card is inset from the viewport's right
      edge, not the container's: 50% - 50cqw is minus the room the container
      leaves free on its right, measured against the body since vw, unlike
      cqw, includes the scrollbar. */}
      <div
        class="invisible sticky bottom-4 flex h-[30svh] flex-col overflow-hidden rounded-lg shadow-lg ring-1 ring-gray-200 short:hidden sm:short:top-4 sm:short:mt-4 sm:short:bottom-auto sm:short:flex sm:short:h-[calc(100vh-2rem)] sm:short:w-[35%] sm:short:shrink-0 sm:short:self-start lg:not-short:mr-[calc(50%-50cqw+1rem)] lg:ml-auto lg:h-auto lg:w-[35%] dark:ring-gray-700"
        data-timeline-map-card
      >
        <button
          class="w-full bg-white px-3 py-1.5 text-left text-sm dark:bg-zinc-900"
          type="button"
          data-timeline-map-caption
        >
          <span class="block" data-place></span>
          <span class="block text-xs text-gray-500" data-date></span>
        </button>
        {/* The library sets `position: relative` on its container, so the
        sticky positioning has to live on a wrapper. */}
        <div
          class="flex-1 sm:short:aspect-auto sm:short:flex-1 lg:aspect-video lg:flex-none dark:invert dark:hue-rotate-180"
          data-timeline-map
        ></div>
      </div>
    </div>
    <script src="../components/timeline-map.ts"></script>
  </Layout>
</BaseLayout>
