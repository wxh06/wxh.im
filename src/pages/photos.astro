---
// The map's stylesheet belongs to the page, not to the script that draws
// the map: styles a script imports are injected when it first runs, and a
// client-side navigation back to this page swaps them out without running
// the script again, leaving the map to lay out unstyled.
import "maplibre-gl/dist/maplibre-gl.css";

import { Image } from "astro:assets";
import { getCollection } from "astro:content";

import BaseLayout from "@/layouts/BaseLayout.astro";
import Layout from "@/layouts/Layout.astro";
import { stayGeometries } from "@/photos/geo";
import { groupTimeline } from "@/photos/timeline";

const entries = groupTimeline(
  (await getCollection("photos")).map(({ id, data }) => ({ id, ...data })),
);
const geometries = stayGeometries(entries);

const regionNames = new Intl.DisplayNames(["en"], { type: "region" });
// Entry days are date-only strings, which parse as UTC midnight; formatting
// in UTC keeps them on the same calendar day.
const days = new Intl.DateTimeFormat("en", {
  dateStyle: "long",
  timeZone: "UTC",
});
const formatDays = (start: string, end: string) =>
  days.formatRange(new Date(start), new Date(end));

const join = (parts: (string | undefined)[], separator: string) =>
  parts.filter(Boolean).join(separator);

// The sublocation is left out when the heading already names it, and the
// file name only stands in when nothing else identifies the photo.
const caption = (
  entry: { location?: string | undefined },
  photo: {
    id: string;
    title?: string | undefined;
    location?: string | undefined;
  },
) => photo.title ?? (entry.location ? undefined : (photo.location ?? photo.id));
---

<BaseLayout title="Photography">
  <Layout>
    <div class="sm:short:flex sm:short:gap-4">
      <ol class="py-4 sm:short:min-w-0 sm:short:flex-1">
        {entries.map((entry, index) => (
          <li
            class="mb-8"
            data-stay
            data-geometry={JSON.stringify(geometries[index])}
          >
            <h2 class="mb-2 text-xl">
              <span data-stay-date>{formatDays(entry.start, entry.end)}</span> ·{" "}
              <span data-stay-place>
                {join(
                  [
                    entry.location,
                    entry.city,
                    regionNames.of(entry.countryCode),
                  ],
                  ", ",
                )}
              </span>
            </h2>
            <ul class="flex flex-col items-center gap-2 sm:flex-row sm:flex-wrap sm:items-stretch">
              {entry.photos.map(({ id, image, title, ...data }) => (
                <li data-photo={id}>
                  <Image src={image} height={240} alt={title ?? id} />
                  <p class="text-sm text-gray-500">
                    {caption(entry, { id, title, location: data.location })}
                  </p>
                  <p class="text-sm text-gray-500">
                    ISO {data.exposure.iso} · {data.exposure.focalLength} mm (
                    {data.exposure.focalLength35mm} mm equiv.) · <i>f</i>/
                    {data.exposure.fNumber} · {data.exposure.exposureTime}
                  </p>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ol>
      {/* As a picture in picture the card is inset from the viewport's right
      edge, not the container's: 50% - 50cqw is minus the room the container
      leaves free on its right, measured against the body since vw, unlike
      cqw, includes the scrollbar. */}
      <div
        class="invisible sticky bottom-4 flex h-[30svh] flex-col overflow-hidden rounded-lg shadow-lg ring-1 ring-gray-200 short:hidden sm:short:top-4 sm:short:mt-4 sm:short:bottom-auto sm:short:flex sm:short:h-[calc(100vh-2rem)] sm:short:w-[35%] sm:short:shrink-0 sm:short:self-start lg:not-short:mr-[calc(50%-50cqw+1rem)] lg:ml-auto lg:h-auto lg:w-[35%] dark:ring-gray-700"
        data-timeline-map-card
      >
        <button
          class="w-full bg-white px-3 py-1.5 text-left text-sm dark:bg-zinc-900"
          type="button"
          data-timeline-map-caption
        >
          <span class="block" data-place></span>
          <span class="block text-xs text-gray-500" data-date></span>
        </button>
        {/* The library sets `position: relative` on its container, so the
        sticky positioning has to live on a wrapper. */}
        <div
          class="flex-1 sm:short:aspect-auto sm:short:flex-1 lg:aspect-video lg:flex-none dark:invert dark:hue-rotate-180"
          data-timeline-map
        ></div>
      </div>
    </div>
    <script src="../components/timeline-map.ts"></script>
  </Layout>
</BaseLayout>
